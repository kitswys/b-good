<odoo noupdate="1">
    <record id="ir_cron_bbbbee_certificate_status" model="ir.cron">
        <field name="name">B-BBEE: Refresh Certificate Status</field>
        <field name="model_id" ref="model_bbbbee_supplier_certificate"/>
        <field name="state">code</field>
        <field name="code">model.search([])._compute_state()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>

    <record id="ir_cron_bbbbee_expiry_reminders" model="ir.cron">
        <field name="name">B-BBEE: Send Expiry Reminders</field>
        <field name="model_id" ref="model_bbbbee_compliance_alert_policy"/>
        <field name="state">code</field>
        <field name="code">model.cron_send_expiry_reminders()</field>
        <field name="interval_number">1</field>
        <field name="interval_type">days</field>
        <field name="active">True</field>
    </record>
</odoo>

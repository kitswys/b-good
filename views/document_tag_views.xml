<odoo>
    <record id="action_bbbbee_document_tag" model="ir.actions.act_window">
        <field name="name">Document Tags</field>
        <field name="res_model">bbbbee.document.tag</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="view_bbbbee_document_tag_list" model="ir.ui.view">
        <field name="name">bbbbee.document.tag.list</field>
        <field name="model">bbbbee.document.tag</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="usage"/>
                <field name="color"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_bbbbee_document_tag_form" model="ir.ui.view">
        <field name="name">bbbbee.document.tag.form</field>
        <field name="model">bbbbee.document.tag</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="usage"/>
                        <field name="color"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

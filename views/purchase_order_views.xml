<odoo>
    <record id="view_purchase_order_form_bbbbee_warning" model="ir.ui.view">
        <field name="name">purchase.order.form.bbbbee.warning</field>
        <field name="model">purchase.order</field>
        <field name="inherit_id" ref="purchase.purchase_order_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="bbbbee_warning" readonly="1" invisible="not bbbbee_warning"/>
                <field name="bbbbee_level" readonly="1"/>
                <field name="bbbbee_recognition_percentage" readonly="1"/>
                <field name="bbbbee_compliance_status" readonly="1"/>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_bbbbee_supplier_certificate_search" model="ir.ui.view">
        <field name="name">bbbbee.supplier.certificate.search</field>
        <field name="model">bbbbee.supplier.certificate</field>
        <field name="arch" type="xml">
            <search>
                <field name="partner_id"/>
                <field name="certificate_type"/>
                <field name="certificate_number"/>
                <field name="state"/>
                <field name="tag_ids"/>
                <filter string="Missing" name="missing" domain="[('state', '=', 'missing')]"/>
                <filter string="Expiring Soon" name="expiring_soon" domain="[('state', '=', 'expiring_soon')]"/>
                <filter string="Expired" name="expired" domain="[('state', '=', 'expired')]"/>
                <filter string="Valid" name="valid" domain="[('state', '=', 'valid')]"/>
            </search>
        </field>
    </record>

    <record id="view_bbbbee_supplier_certificate_list" model="ir.ui.view">
        <field name="name">bbbbee.supplier.certificate.list</field>
        <field name="model">bbbbee.supplier.certificate</field>
        <field name="arch" type="xml">
            <list class="o_list_view_table table table-sm table-hover bbbbee-table-view bbbbee-premium-list bbbbee-certificate-list">
                <field name="partner_id" width="40%" class="font-weight-bold text-dark"/>
                <field name="certificate_type" width="14%"/>
                <field name="certificate_number" width="16%"/>
                <field name="issue_date" width="10%"/>
                <field name="expiry_date" width="10%"/>
                <field name="tag_ids" widget="many2many_tags" width="14%"/>
                <field name="attachment_marker_html" string="File" widget="html" width="5%"/>
                <field name="state_badge_html" string="State" widget="html" width="15%"/>
            </list>
        </field>
    </record>

    <record id="view_bbbbee_supplier_certificate_form" model="ir.ui.view">
        <field name="name">bbbbee.supplier.certificate.form</field>
        <field name="model">bbbbee.supplier.certificate</field>
        <field name="arch" type="xml">
            <form class="bbbbee-ui">
                <header>
                    <button name="action_supersede" type="object" string="Supersede"/>
                    <field name="state" widget="statusbar"/>
                </header>
                <sheet>
                    <group>
                        <div class="bbbbee-help-box">
                            <strong>Screen Help:</strong> Upload supplier evidence here.
                            <br/>
                            If a record is <em>Missing</em>, upload an attachment. If <em>Expired</em>, add a new certificate and supersede old records.
                        </div>
                    </group>
                    <group>
                        <field name="profile_id" options="{'no_create': True, 'no_create_edit': True}"/>
                        <field name="certificate_type"/>
                        <field name="certificate_number"/>
                        <field name="issue_date"/>
                        <field name="expiry_date"/>
                        <field name="tag_ids" widget="many2many_tags"/>
                        <field name="attachment_file" widget="binary" filename="attachment_filename"/>
                        <field name="attachment_id" invisible="1"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>
</odoo>

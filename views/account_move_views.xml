<odoo>
    <record id="view_account_move_form_bbbbee_fields" model="ir.ui.view">
        <field name="name">account.move.form.bbbbee.fields</field>
        <field name="model">account.move</field>
        <field name="inherit_id" ref="account.view_move_form"/>
        <field name="arch" type="xml">
            <xpath expr="//field[@name='partner_id']" position="after">
                <field name="bbbbee_level" readonly="1"/>
                <field name="bbbbee_recognition_percentage" readonly="1"/>
                <field name="bbbbee_compliance_status" readonly="1"/>
                <field name="bbbbee_warning" readonly="1" invisible="not bbbbee_warning"/>
            </xpath>
        </field>
    </record>
</odoo>

<odoo>
    <record id="view_bbbbee_supplier_profile_list" model="ir.ui.view">
        <field name="name">bbbbee.supplier.profile.list</field>
        <field name="model">bbbbee.supplier.profile</field>
        <field name="arch" type="xml">
            <list>
                <field name="partner_id"/>
                <field name="bbbbee_level"/>
                <field name="recognition_percentage"/>
                <field name="compliance_status"/>
                <field name="active_certificate_id"/>
            </list>
        </field>
    </record>

    <record id="view_bbbbee_supplier_profile_form" model="ir.ui.view">
        <field name="name">bbbbee.supplier.profile.form</field>
        <field name="model">bbbbee.supplier.profile</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="partner_id"/>
                        <field name="bbbbee_level"/>
                        <field name="recognition_percentage"/>
                        <field name="compliance_status" readonly="1"/>
                    </group>
                    <notebook>
                        <page string="Ownership">
                            <group>
                                <field name="black_ownership_percentage"/>
                                <field name="black_women_ownership_percentage"/>
                                <field name="empowering_supplier_status"/>
                            </group>
                        </page>
                        <page string="Evidence">
                            <field name="certificate_ids"/>
                        </page>
                    </notebook>
                </sheet>
                <chatter/>
            </form>
        </field>
    </record>
</odoo>

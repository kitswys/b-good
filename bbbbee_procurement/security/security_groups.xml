<odoo>
    <record id="module_category_bbbbee" model="ir.module.category">
        <field name="name">B-BBEE Procurement</field>
        <field name="sequence">35</field>
    </record>

    <record id="group_bbbbee_user" model="res.groups">
        <field name="name">B-BBEE User</field>
        <field name="category_id" ref="module_category_bbbbee"/>
    </record>

    <record id="group_bbbbee_compliance_officer" model="res.groups">
        <field name="name">B-BBEE Compliance Officer</field>
        <field name="category_id" ref="module_category_bbbbee"/>
        <field name="implied_ids" eval="[(4, ref('group_bbbbee_user'))]"/>
    </record>

    <record id="group_bbbbee_finance_user" model="res.groups">
        <field name="name">B-BBEE Finance User</field>
        <field name="category_id" ref="module_category_bbbbee"/>
        <field name="implied_ids" eval="[(4, ref('group_bbbbee_user'))]"/>
    </record>

    <record id="group_bbbbee_manager" model="res.groups">
        <field name="name">B-BBEE Manager</field>
        <field name="category_id" ref="module_category_bbbbee"/>
        <field name="implied_ids" eval="[(4, ref('group_bbbbee_compliance_officer')), (4, ref('group_bbbbee_finance_user'))]"/>
    </record>

    <record id="group_bbbbee_administrator" model="res.groups">
        <field name="name">B-BBEE Administrator</field>
        <field name="category_id" ref="module_category_bbbbee"/>
        <field name="implied_ids" eval="[(4, ref('group_bbbbee_manager'))]"/>
    </record>
</odoo>

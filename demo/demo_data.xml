<odoo noupdate="1">
    <record id="demo_supplier_kora" model="res.partner">
        <field name="name">Kora Industrial Supplies (Pty) Ltd</field>
        <field name="supplier_rank">1</field>
    </record>

    <record id="demo_supplier_amber" model="res.partner">
        <field name="name">Amber Route Freight CC</field>
        <field name="supplier_rank">1</field>
    </record>

    <record id="demo_supplier_ndlovu" model="res.partner">
        <field name="name">Ndlovu Office Systems (Pty) Ltd</field>
        <field name="supplier_rank">1</field>
    </record>

    <record id="demo_supplier_summit" model="res.partner">
        <field name="name">Summit Fleet Services (Pty) Ltd</field>
        <field name="supplier_rank">1</field>
    </record>

    <record id="demo_supplier_ubuntu" model="res.partner">
        <field name="name">Ubuntu Packaging Co</field>
        <field name="supplier_rank">1</field>
    </record>

    <record id="demo_supplier_kora_profile" model="bbbbee.supplier.profile">
        <field name="partner_id" ref="demo_supplier_kora"/>
        <field name="bbbbee_level">5</field>
        <field name="recognition_percentage">80.0</field>
        <field name="black_ownership_percentage">51.0</field>
        <field name="black_women_ownership_percentage">20.0</field>
        <field name="empowering_supplier_status">yes</field>
    </record>

    <record id="demo_supplier_amber_profile" model="bbbbee.supplier.profile">
        <field name="partner_id" ref="demo_supplier_amber"/>
        <field name="bbbbee_level">7</field>
        <field name="recognition_percentage">50.0</field>
        <field name="black_ownership_percentage">28.0</field>
        <field name="black_women_ownership_percentage">11.0</field>
        <field name="empowering_supplier_status">no</field>
    </record>

    <record id="demo_supplier_ndlovu_profile" model="bbbbee.supplier.profile">
        <field name="partner_id" ref="demo_supplier_ndlovu"/>
        <field name="bbbbee_level">8</field>
        <field name="recognition_percentage">10.0</field>
        <field name="black_ownership_percentage">0.0</field>
        <field name="black_women_ownership_percentage">0.0</field>
        <field name="empowering_supplier_status">unknown</field>
    </record>

    <record id="demo_supplier_summit_profile" model="bbbbee.supplier.profile">
        <field name="partner_id" ref="demo_supplier_summit"/>
        <field name="bbbbee_level">4</field>
        <field name="recognition_percentage">100.0</field>
        <field name="black_ownership_percentage">60.0</field>
        <field name="black_women_ownership_percentage">24.0</field>
        <field name="empowering_supplier_status">yes</field>
    </record>

    <record id="demo_supplier_ubuntu_profile" model="bbbbee.supplier.profile">
        <field name="partner_id" ref="demo_supplier_ubuntu"/>
        <field name="bbbbee_level">6</field>
        <field name="recognition_percentage">55.0</field>
        <field name="black_ownership_percentage">19.0</field>
        <field name="black_women_ownership_percentage">8.0</field>
        <field name="empowering_supplier_status">yes</field>
    </record>

    <record id="demo_document_tag_certificate" model="bbbbee.document.tag">
        <field name="name">B-BBEE Certificate</field>
        <field name="usage">both</field>
    </record>

    <record id="demo_document_tag_affidavit" model="bbbbee.document.tag">
        <field name="name">Affidavit</field>
        <field name="usage">both</field>
    </record>

    <record id="demo_document_tag_review" model="bbbbee.document.tag">
        <field name="name">Review Required</field>
        <field name="usage">both</field>
    </record>

    <record id="demo_supplier_kora_attachment" model="ir.attachment">
        <field name="name">Kora BBBEE Certificate.txt</field>
        <field name="type">binary</field>
        <field name="datas" type="base64">RGVtbyBCR0JFRSBDZXJ0aWZpY2F0ZQ==</field>
        <field name="mimetype">text/plain</field>
    </record>

    <record id="demo_supplier_amber_attachment" model="ir.attachment">
        <field name="name">Amber Route Affidavit.txt</field>
        <field name="type">binary</field>
        <field name="datas" type="base64">QW1iZXIgcm91dGUgYWZmaWRhdml0</field>
        <field name="mimetype">text/plain</field>
    </record>

    <record id="demo_supplier_kora_certificate" model="bbbbee.supplier.certificate">
        <field name="profile_id" ref="demo_supplier_kora_profile"/>
        <field name="certificate_type">certificate</field>
        <field name="certificate_number">KIS-2026-041</field>
        <field name="issue_date">2026-02-12</field>
        <field name="expiry_date">2027-02-11</field>
        <field name="attachment_id" ref="demo_supplier_kora_attachment"/>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_certificate')])]"/>
    </record>

    <record id="demo_supplier_amber_certificate" model="bbbbee.supplier.certificate">
        <field name="profile_id" ref="demo_supplier_amber_profile"/>
        <field name="certificate_type">affidavit</field>
        <field name="certificate_number">ARF-A-2026</field>
        <field name="issue_date">2026-03-01</field>
        <field name="expiry_date">2026-11-30</field>
        <field name="attachment_id" ref="demo_supplier_amber_attachment"/>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_affidavit'), ref('demo_document_tag_review')])]"/>
    </record>

    <record id="demo_supplier_ndlovu_certificate" model="bbbbee.supplier.certificate">
        <field name="profile_id" ref="demo_supplier_ndlovu_profile"/>
        <field name="certificate_type">certificate</field>
        <field name="certificate_number">NOS-2025-990</field>
        <field name="issue_date">2025-06-15</field>
        <field name="expiry_date">2026-06-14</field>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_review')])]"/>
    </record>

    <record id="demo_supplier_summit_certificate" model="bbbbee.supplier.certificate">
        <field name="profile_id" ref="demo_supplier_summit_profile"/>
        <field name="certificate_type">affidavit</field>
        <field name="certificate_number">SSF-A-2026</field>
        <field name="issue_date">2026-01-05</field>
        <field name="expiry_date">2026-12-31</field>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_affidavit')])]"/>
    </record>

    <record id="demo_supplier_ubuntu_certificate" model="bbbbee.supplier.certificate">
        <field name="profile_id" ref="demo_supplier_ubuntu_profile"/>
        <field name="certificate_type">certificate</field>
        <field name="certificate_number">UPC-2025-778</field>
        <field name="issue_date">2025-10-01</field>
        <field name="expiry_date">2026-03-31</field>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_review')])]"/>
    </record>

    <record id="demo_measurement_period" model="bbbbee.measurement.period">
        <field name="name">FY2026</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="date_start">2026-01-01</field>
        <field name="date_end">2026-12-31</field>
        <field name="active_rule_set_id" ref="rule_set_generic_procurement"/>
    </record>

    <record id="demo_spend_batch" model="bbbbee.spend.batch">
        <field name="name">FY2026 H1 Procurement</field>
        <field name="measurement_period_id" ref="demo_measurement_period"/>
        <field name="company_id" ref="base.main_company"/>
        <field name="state">review</field>
    </record>

    <record id="demo_spend_line_kora" model="bbbbee.spend.line">
        <field name="batch_id" ref="demo_spend_batch"/>
        <field name="partner_id" ref="demo_supplier_kora"/>
        <field name="invoice_date">2026-04-04</field>
        <field name="untaxed_amount">110000.0</field>
        <field name="excluded_amount">0.0</field>
        <field name="recognition_percentage">80.0</field>
        <field name="classification">included</field>
        <field name="evidence_status">valid</field>
    </record>

    <record id="demo_spend_line_amber" model="bbbbee.spend.line">
        <field name="batch_id" ref="demo_spend_batch"/>
        <field name="partner_id" ref="demo_supplier_amber"/>
        <field name="invoice_date">2026-04-11</field>
        <field name="untaxed_amount">75000.0</field>
        <field name="excluded_amount">5000.0</field>
        <field name="recognition_percentage">50.0</field>
        <field name="classification">review_required</field>
        <field name="evidence_status">review_required</field>
    </record>

    <record id="demo_spend_line_ndlovu" model="bbbbee.spend.line">
        <field name="batch_id" ref="demo_spend_batch"/>
        <field name="partner_id" ref="demo_supplier_ndlovu"/>
        <field name="invoice_date">2026-03-22</field>
        <field name="untaxed_amount">95000.0</field>
        <field name="excluded_amount">0.0</field>
        <field name="recognition_percentage">10.0</field>
        <field name="classification">included</field>
        <field name="evidence_status">missing</field>
    </record>

    <record id="demo_spend_line_summit" model="bbbbee.spend.line">
        <field name="batch_id" ref="demo_spend_batch"/>
        <field name="partner_id" ref="demo_supplier_summit"/>
        <field name="invoice_date">2026-02-27</field>
        <field name="untaxed_amount">130000.0</field>
        <field name="excluded_amount">20000.0</field>
        <field name="recognition_percentage">100.0</field>
        <field name="classification">included</field>
        <field name="evidence_status">valid</field>
    </record>

    <record id="demo_spend_line_ubuntu" model="bbbbee.spend.line">
        <field name="batch_id" ref="demo_spend_batch"/>
        <field name="partner_id" ref="demo_supplier_ubuntu"/>
        <field name="invoice_date">2026-01-19</field>
        <field name="untaxed_amount">280000.0</field>
        <field name="excluded_amount">0.0</field>
        <field name="recognition_percentage">55.0</field>
        <field name="classification">included</field>
        <field name="evidence_status">expired</field>
    </record>

    <record id="demo_scorecard_assessment" model="bbbbee.scorecard.assessment">
        <field name="name">FY2026 Procurement Assessment</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="measurement_period_id" ref="demo_measurement_period"/>
        <field name="rule_set_id" ref="rule_set_generic_procurement"/>
        <field name="spend_batch_ids" eval="[(6, 0, [ref('demo_spend_batch')])]"/>
    </record>

    <record id="demo_evidence_pack" model="bbbbee.evidence.pack">
        <field name="name">FY2026 H1 Evidence Pack</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="measurement_period_id" ref="demo_measurement_period"/>
        <field name="assessment_id" ref="demo_scorecard_assessment"/>
        <field name="state">generated</field>
    </record>

    <record id="demo_evidence_item_summary" model="bbbbee.evidence.item">
        <field name="pack_id" ref="demo_evidence_pack"/>
        <field name="name">Summary</field>
        <field name="item_type">summary</field>
        <field name="note">Audit pack with missing documents, valid certificates, and review items.</field>
    </record>

    <record id="demo_evidence_item_certificate" model="bbbbee.evidence.item">
        <field name="pack_id" ref="demo_evidence_pack"/>
        <field name="name">Kora certificate</field>
        <field name="item_type">certificate</field>
        <field name="attachment_id" ref="demo_supplier_kora_attachment"/>
        <field name="tag_ids" eval="[(6, 0, [ref('demo_document_tag_certificate')])]"/>
    </record>

    <record id="demo_evidence_item_missing" model="bbbbee.evidence.item">
        <field name="pack_id" ref="demo_evidence_pack"/>
        <field name="name">Ndlovu evidence gap</field>
        <field name="item_type">missing_evidence</field>
        <field name="note">Supplier evidence is missing for review purposes.</field>
    </record>

    <record id="demo_alert_policy" model="bbbbee.compliance.alert.policy">
        <field name="name">Demo Alert Policy</field>
        <field name="company_id" ref="base.main_company"/>
        <field name="reminder_days">30,14,7</field>
    </record>
</odoo>
